{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "src/styles/globals.css",
    "baseColor": "slate",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "src/components",
    "utils": "src/utils",
    "ui": "src/components/ui",
    "lib": "src/lib",
    "hooks": "src/hooks"
  },
  "iconLibrary": "lucide",
  "themes": {
    "enabled": true,
    "defaultTheme": "light",
    "availableThemes": [
      "light",
      "dark",
      "blue",
      "green",
      "purple",
      "red",
      "orange",
      "pink",
      "gray",
      "yellow"
    ]
  },
  "animations": {
    "enabled": true,
    "library": "framer-motion",
    "defaultDuration": 0.2,
    "defaultEasing": "easeInOut"
  },
  "typescript": {
    "strict": false,
    "declaration": true,
    "declarationMap": true
  },
  "components": {
    "baseClass": "th-ui",
    "compoundComponents": true,
    "forwardRef": true,
    "accessibility": true,
    "darkMode": true,
    "responsive": true
  },
  "build": {
    "libraryMode": true,
    "outputDirectory": "dist",
    "sourceMaps": true,
    "minify": true,
    "sourcemap": true
  },
  "testing": {
    "framework": "vitest",
    "library": "@testing-library/react",
    "coverage": true,
    "coverageThreshold": 80
  },
  "documentation": {
    "storybook": false,
    "typedoc": true,
    "examples": true
  },
  "deployment": {
    "docker": true,
    "npm": true,
    "cdn": false
  }
}