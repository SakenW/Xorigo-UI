# Xorigo UI Collaboration & Share System Environment Configuration

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xorigo_ui
DB_USER=postgres
DB_PASSWORD=postgres123

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# ============================================
# WebSocket Configuration
# ============================================
WEBSOCKET_URL=ws://localhost:3001
WEBSOCKET_PORT=3001
WEBSOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:3100

# Maximum connections per room
WEBSOCKET_MAX_CONNECTIONS=10
WEBSOCKET_PING_INTERVAL=30000
WEBSOCKET_PING_TIMEOUT=5000

# ============================================
# Share Link Configuration
# ============================================
# Secret key for generating share link tokens
SHARE_SECRET=your-secret-key-change-in-production

# Default share link expiration (in seconds, 0 = no expiration)
DEFAULT_SHARE_EXPIRATION=86400

# Maximum share link access count (0 = unlimited)
DEFAULT_MAX_ACCESS_COUNT=100

# Base URL for share links
SHARE_BASE_URL=http://localhost:3100

# ============================================
# Security Configuration
# ============================================
# JWT secret for authentication
JWT_SECRET=your-jwt-secret-change-in-production

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# ============================================
# Collaboration Settings
# ============================================
# Maximum users per room
MAX_USERS_PER_ROOM=10

# Cursor update throttle (in milliseconds)
CURSOR_UPDATE_THROTTLE=50

# Cursor cleanup interval (in milliseconds)
CURSOR_CLEANUP_INTERVAL=5000

# Cursor timeout (in milliseconds)
CURSOR_TIMEOUT=30000

# ============================================
# Team & Template Settings
# ============================================
# Maximum team members
MAX_TEAM_MEMBERS=50

# Default team template visibility
DEFAULT_TEMPLATE_VISIBILITY=private

# Template version history limit
MAX_VERSION_HISTORY=100

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/collaboration.log

# ============================================
# Performance Configuration
# ============================================
# Database connection pool size
DB_POOL_SIZE=10
DB_POOL_MIN=5
DB_POOL_MAX=20

# Redis connection pool size
REDIS_POOL_SIZE=10

# ============================================
# Monitoring Configuration
# ============================================
# Enable Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Metrics interval
METRICS_INTERVAL=60s
