{
  "name": "xorigo-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Xorigo UI Monorepo - Modern UI component library with Next.js 15 website",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm local:dev",
    "dev:core": "pnpm --filter @xorigo-ui/core dev",
    "dev:website": "pnpm --filter website dev --port 3100",
    "dev:docs": "pnpm --filter @xorigo-ui/docs dev",
    "build": "pnpm --filter @xorigo-ui/core build",
    "build:all": "pnpm build --workspaces",
    "build:docs": "pnpm --filter @xorigo-ui/docs build",
    "test": "pnpm test --workspaces",
    "lint": "pnpm lint --workspaces",
    "lint:docs": "pnpm --filter @xorigo-ui/docs lint",
    "type-check": "echo 'TypeScript检查暂时禁用，需要手动运行 pnpm -r --filter=\"!@xorigo-ui/core\" tsc --noEmit'",
    "type-check:docs": "pnpm --filter @xorigo-ui/docs type-check",
    "clean": "pnpm clean --workspaces && rm -rf node_modules",
    "check-dependencies": "bash scripts/check-dependencies.sh",
    "validate-packages": "node scripts/validate-packages.js",
    "storybook": "storybook dev -p 6009",
    "build-storybook": "storybook build",
    "local:dev": "node scripts/dev-env-manager.js local",
    "local:dev:core": "pnpm dev:core",
    "local:dev:website": "pnpm dev:website",
    "local:dev:all": "concurrently \"pnpm dev:core\" \"pnpm dev:website\"",
    "server:start": "bash scripts/dev-server.sh start",
    "server:stop": "bash scripts/dev-server.sh stop",
    "server:restart": "bash scripts/dev-server.sh restart",
    "server:status": "bash scripts/dev-server.sh status",
    "server:cleanup": "bash scripts/dev-server.sh cleanup",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev:monorepo": "docker-compose -f docker-compose.dev.monorepo.yml up --build",
    "docker:stop": "docker-compose -f docker-compose.dev.yml down",
    "docker:stop:monorepo": "docker-compose -f docker-compose.dev.monorepo.yml down",
    "docker:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "docker:logs:monorepo": "docker-compose -f docker-compose.dev.monorepo.yml logs -f",
    "agent:start": "bash scripts/agent-dev-server.sh start",
    "agent:stop": "bash scripts/agent-dev-server.sh stop",
    "agent:restart": "bash scripts/agent-dev-server.sh restart",
    "agent:build": "bash scripts/agent-dev-server.sh build",
    "agent:rebuild": "bash scripts/agent-dev-server.sh rebuild",
    "agent:clean": "bash scripts/agent-dev-server.sh clean",
    "agent:logs": "bash scripts/agent-dev-server.sh logs",
    "agent:status": "bash scripts/agent-dev-server.sh status",
    "agent:info": "bash scripts/agent-dev-server.sh info",
    "agent:check": "bash scripts/agent-dev-server.sh check",
    "agent:cleanup": "bash scripts/agent-dev-server.sh cleanup",
    "agent:health": "bash scripts/agent-dev-server.sh health",
    "docker:build": "bash scripts/agent-dev-server.sh build",
    "docker:rebuild": "bash scripts/agent-dev-server.sh rebuild",
    "docker:clean": "bash scripts/agent-dev-server.sh clean",
    "deploy": "bash scripts/deploy.sh",
    "deploy:stop": "bash scripts/deploy-stop.sh",
    "deploy:logs": "bash scripts/deploy-logs.sh",
    "deploy:rebuild": "bash scripts/deploy-rebuild.sh",
    "visual:test": "playwright test tests/visual",
    "visual:test:headed": "playwright test tests/visual --headed",
    "visual:test:debug": "playwright test tests/visual --debug",
    "visual:test:ui": "playwright test tests/visual --ui",
    "visual:test:report": "node scripts/visual-test-summary.js",
    "visual:test:update": "bash scripts/update-visual-baselines.sh --all",
    "visual:update:component": "bash scripts/update-visual-baselines.sh --component",
    "visual:update:theme": "bash scripts/update-visual-baselines.sh --theme",
    "visual:serve": "npx http-server tests/visual -p 3101 -c-1 --cors",
    "visual:setup": "npx playwright install && npx playwright install-deps",
    "visual:clean": "rm -rf test-results playwright-report visual-reports tests/visual/screenshots/actual tests/visual/screenshots/diff",
    "test:visual": "pnpm visual:test",
    "test:visual:ci": "CI=true pnpm visual:test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "release:beta": "changeset publish --tag beta",
    "release:alpha": "changeset publish --tag alpha",
    "release:dry-run": "changeset publish --dry-run",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm build:packages",
    "build:packages": "pnpm -r --if-present build",
    "lint:changed": "npx lint-staged",
    "prepare": "husky install || true",
    "check:all": "pnpm lint && pnpm type-check && pnpm test && pnpm build:all",
    "release:validate": "node scripts/validate-release.js",
    "security:audit": "pnpm audit --audit-level=high",
    "security:fix": "pnpm audit fix",
    "deps:update": "pnpm update --save",
    "deps:check": "pnpm outdated"
  },
  "keywords": [
    "monorepo",
    "react",
    "ui",
    "components",
    "design-system",
    "nextjs",
    "xorigo-ui"
  ],
  "author": "Xorigo UI Team",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.1",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@storybook/testing-library": "^0.2.2",
    "@types/node": "^24.7.2",
    "concurrently": "^9.1.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "eslint-plugin-storybook": "9.1.10",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "madge": "^8.0.0",
    "only-allow": "^1.2.1",
    "playwright": "^1.56.0",
    "playwright-chromium": "^1.56.0",
    "playwright-firefox": "^1.56.0",
    "playwright-webkit": "^1.56.0",
    "prettier": "^3.6.2",
    "readline": "^1.3.0",
    "storybook": "^9.1.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0",
    "yarn": ">=4.0.0",
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/xorigo-ui.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/xorigo-ui/issues"
  },
  "homepage": "https://github.com/your-org/xorigo-ui#readme",
  "dependencies": {
    "ajv": "^8.17.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "chore",
          "revert",
          "build",
          "ci",
          "release"
        ]
      ],
      "scope-case": [
        2,
        "always",
        "pascal-case"
      ],
      "subject-case": [
        2,
        "never",
        [
          "start-case",
          "pascal-case",
          "upper-case"
        ]
      ]
    }
  }
}