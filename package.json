{
  "name": "th-ui",
  "version": "0.1.0",
  "private": true,
  "description": "TH-UI Monorepo - Modern UI component library with Next.js 15 website",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@th-ui/core run dev",
    "dev:website": "npm --workspace=website run dev",
    "build": "npm --workspace=@th-ui/core run build",
    "build:all": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "docker:dev": "bash scripts/dev-docker.sh",
    "docker:logs": "bash scripts/dev-docker-logs.sh",
    "docker:stop": "bash scripts/dev-docker-stop.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:stop": "bash scripts/deploy-stop.sh",
    "deploy:logs": "bash scripts/deploy-logs.sh",
    "deploy:rebuild": "bash scripts/deploy-rebuild.sh"
  },
  "keywords": [
    "monorepo",
    "react",
    "ui",
    "components",
    "design-system",
    "nextjs",
    "th-ui"
  ],
  "author": "TH-UI Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0",
    "yarn": ">=4.0.0",
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/th-ui.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/th-ui/issues"
  },
  "homepage": "https://github.com/your-org/th-ui#readme"
}
