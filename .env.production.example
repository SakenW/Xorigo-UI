# ============================================
# Xorigo UI 生产环境配置文件 - Phase 6
# 复制此文件为 .env.production 并填入实际值
# ============================================

# 应用配置
NODE_ENV=production
VERSION=latest
BUILD_TIME=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
GIT_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")

# 服务端口配置
WEBSITE_PORT=3100
HTTP_PORT=80
HTTPS_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
REDIS_PORT=6379

# 域名配置
DOMAIN=localhost
# DOMAIN=your-domain.com  # 生产环境填写实际域名

# 监控配置
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=latest

# Core Web Vitals 监控
WEB_VITALS_ENABLED=true
WEB_VITALS_SAMPLE_RATE=0.1

# Grafana 配置
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-secure-password

# Redis 配置
REDIS_PASSWORD=your-redis-password

# SSL/TLS 配置 (生产环境)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# 安全配置
CORS_ORIGIN=https://your-domain.com
RATE_LIMIT_GENERAL=30r/s
RATE_LIMIT_API=10r/s

# 缓存配置
NGINX_CACHE_SIZE=1g
NGINX_CACHE_INACTIVE=60m

# 日志配置
LOG_LEVEL=info
LOG_MAX_SIZE=100m
LOG_MAX_FILES=5

# 备份配置
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# 监控阈值
MEMORY_THRESHOLD=85
CPU_THRESHOLD=80
DISK_THRESHOLD=85
RESPONSE_TIME_THRESHOLD=2000

# 通知配置 (可选)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# 零停机部署配置
ZERO_DOWNTIME_ENABLED=true
HEALTH_CHECK_TIMEOUT=300
DEPLOYMENT_TIMEOUT=600
MAX_RETRIES=3

# 数据库配置 (如果使用)
DATABASE_URL=postgresql://user:password@localhost:5432/xorigo_ui
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=30

# CDN 配置 (如果使用)
CDN_URL=https://cdn.your-domain.com
CDN_ENABLED=false

# 功能开关
FEATURE_ANALYTICS=true
FEATURE_ERROR_MONITORING=true
FEATURE_PERFORMANCE_MONITORING=true
FEATURE_SECURITY_HEADERS=true
FEATURE_RATE_LIMITING=true