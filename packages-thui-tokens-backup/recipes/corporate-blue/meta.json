{
  "$type": "recipe",
  "$description": "Corporate Blue 配方元数据 - 七轴参数定义",
  "id": "light.neutral-cool-mid.mono(blue).standard.comfortable.standard.soft-shadow",
  "name": "Corporate Blue",
  "description": "专业企业级蓝色主题，适用于SaaS控制台和商业应用",
  "category": "corporate",
  "version": "1.0.0",
  "tags": ["professional", "business", "saas", "corporate", "blue"],

  "axes": {
    "$type": "axes",
    "$description": "七轴风格配方参数",
    "mode": {
      "$type": "axis",
      "$value": "light",
      "$description": "光照模式 - 亮色主题"
    },
    "base": {
      "$type": "axis",
      "$value": {
        "neutral": "neutral-cool",
        "contrast": "mid"
      },
      "$description": "中性色谱 × 对比 - 冷色调中对比度"
    },
    "accent": {
      "$type": "axis",
      "$value": {
        "strategy": "mono",
        "hues": ["blue"]
      },
      "$description": "主色策略 - 单色蓝色策略"
    },
    "tone": {
      "$type": "axis",
      "$value": "standard",
      "$description": "强度 - 标准饱和度/亮度曲线"
    },
    "density": {
      "$type": "axis",
      "$value": "comfortable",
      "$description": "密度 - 舒适的信息密度"
    },
    "motion": {
      "$type": "axis",
      "$value": {
        "pack": "standard",
        "curve": "classic"
      },
      "$description": "动效 - 标准节奏 + 经典曲线"
    },
    "surface": {
      "$type": "axis",
      "$value": ["soft-shadow"],
      "$description": "表面 - 柔和阴影材质"
    }
  },

  "oklchTone": {
    "$type": "tone-modulation",
    "$description": "OKLCH 色调调制参数",
    "calm": {
      "$type": "tone-params",
      "$description": "冷静色调 - 降低彩度，微提亮度",
      "dC": -0.05,
      "$description": "彩度变化量 -5%"
    },
    "standard": {
      "$type": "tone-params",
      "$description": "标准色调 - 无变化",
      "dC": 0,
      "$description": "彩度变化量 0%"
    },
    "vivid": {
      "$type": "tone-params",
      "$description": "鲜艳色调 - 增强彩度，轻微降低亮度",
      "dC": +0.05,
      "$description": "彩度变化量 +5%"
    }
  },

  "darkModeMapping": {
    "$type": "dark-mapping",
    "$description": "Dark 模式非对称映射参数",
    "neutral": {
      "$type": "mapping-params",
      "$description": "中性色 Dark 映射",
      "dL": +0.05,
      "$description": "亮度变化 +5%"
    },
    "accent": {
      "$type": "mapping-params",
      "$description": "强调色 Dark 映射",
      "dC": -0.4,
      "$description": "彩度变化 -40%"
    }
  },

  "accessibility": {
    "$type": "accessibility",
    "$description": "可访问性配置",
    "contrast": {
      "$type": "contrast-ratios",
      "$description": "对比度要求",
      "text": 4.5,
      "$description": "正文对比度 4.5:1 (AA)",
      "largeText": 3.0,
      "$description": "大字对比度 3:0 (AA)",
      "nonText": 3.0,
      "$description": "非文本对比度 3:0 (AA)"
    },
    "focus": {
      "$type": "focus-settings",
      "$description": "焦点环设置",
      "alwaysVisible": true,
      "$description": "焦点环始终可见",
      "minContrast": 3.0,
      "$description": "焦点环最小对比度 3:0"
    },
    "motion": {
      "$type": "motion-settings",
      "$description": "动效可访问性",
      "respectReducedMotion": true,
      "$description": "遵循 prefers-reduced-motion",
      "fallbackDuration": "150ms",
      "$description": "降级时长 150ms"
    },
    "cvd": {
      "$type": "cvd-settings",
      "$description": "色盲友好设置",
      "colorBlindFriendly": true,
      "$description": "色盲友好设计",
      "useColorAndShape": true,
      "$description": "色+形双编码"
    }
  },

  "compatibility": {
    "$type": "compatibility",
    "$description": "兼容性设置",
    "forcedColors": {
      "$type": "forced-colors-settings",
      "$description": "强制颜色模式适配",
      "enabled": true,
      "$description": "支持 forced-colors"
    },
    "legacySupport": {
      "$type": "legacy-support",
      "$description": "旧版本兼容性",
      "cssVariables": true,
      "$description": "CSS 变量支持",
      "classBased": true,
      "$description": "类名支持"
    }
  },

  "metadata": {
    "$type": "metadata",
    "$description": "配方元数据",
    "author": "TH-UI Team",
    "$description": "作者团队",
    "created": "2025-10-11",
    "$description": "创建日期",
    "updated": "2025-10-11",
    "$description": "更新日期",
    "license": "MIT",
    "$description": "许可证",
    "repository": "https://github.com/th-ui/tokens",
    "$description": "代码仓库",
    "documentation": "https://th-ui.dev/docs/recipes/corporate-blue",
    "$description": "文档链接"
  }
}