#### Webpack配置优化
```javascript
// next.config.js
const nextConfig = {
  experimental: {
    optimizePackageImports: ['@xorigo-ui/core', 'framer-motion']
  },
  compiler: {
    removeConsole: process.env.NODE_ENV === 'production',
  },
  webpack: (config, { isServer }) => {
