{
  "name": "xorigo-component-migrator",
  "description": "Xorigo UI 组件迁移工具 - 自动分析和迁移工作台组件到最新架构",
  "version": "1.0.0",
  "author": "Xorigo UI Team",
  "category": "development",
  "tags": ["migration", "components", "workbench", "automation"],
  "entrypoint": "skill.py",
  "features": [
    "自动扫描和分析工作台组件",
    "智能识别需要迁移的组件",
    "创建完整备份",
    "执行组件迁移和整合",
    "生成详细的迁移报告",
    "支持优先级分类 (高/中/低)"
  ],
  "output": {
    "success": "bool - 迁移是否成功",
    "stats": "object - 迁移统计信息",
    "backup_dir": "string - 备份目录路径",
    "message": "string - 迁移结果消息"
  }
}
