{
  "$type": "component",
  "$description": "按钮组件别名令牌 - 仅引用 Role 令牌",
  "button": {
    "$type": "component",
    "$description": "按钮组件样式",
    "variants": {
      "primary": {
        "$type": "variant",
        "$description": "主要按钮变体",
        "bg": {
          "$value": "{accent.default}",
          "$type": "color"
        },
        "fg": {
          "$value": "{text.inverse}",
          "$type": "color"
        },
        "border": {
          "$value": "{accent.default}",
          "$type": "color"
        },
        "hover": {
          "$value": "{accent.hover}",
          "$type": "color"
        },
        "active": {
          "$value": "{accent.active}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{text.disabled}",
          "$type": "color"
        }
      },
      "secondary": {
        "$type": "variant",
        "$description": "次要按钮变体",
        "bg": {
          "$value": "{background.surface}",
          "$type": "color"
        },
        "fg": {
          "$value": "{accent.default}",
          "$type": "color"
        },
        "border": {
          "$value": "{accent.default}",
          "$type": "color"
        },
        "hover": {
          "$value": "{background.elevated}",
          "$type": "color"
        },
        "active": {
          "$value": "{background.subtle}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{text.disabled}",
          "$type": "color"
        }
      },
      "outline": {
        "$type": "variant",
        "$description": "轮廓按钮变体",
        "bg": {
          "$value": "transparent",
          "$type": "color"
        },
        "fg": {
          "$value": "{accent.default}",
          "$type": "color"
        },
        "border": {
          "$value": "{accent.default}",
          "$type": "color"
        },
        "hover": {
          "$value": "{accent.hover}",
          "$type": "color"
        },
        "active": {
          "$value": "{accent.active}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{text.disabled}",
          "$type": "color"
        }
      },
      "ghost": {
        "$type": "variant",
        "$description": "幽灵按钮变体",
        "bg": {
          "$value": "transparent",
          "$type": "color"
        },
        "fg": {
          "$value": "{text.primary}",
          "$type": "color"
        },
        "border": {
          "$value": "transparent",
          "$type": "color"
        },
        "hover": {
          "$value": "{background.surface}",
          "$type": "color"
        },
        "active": {
          "$value": "{background.subtle}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{text.disabled}",
          "$type": "color"
        }
      }
    },
    "sizes": {
      "xs": {
        "$type": "size",
        "$description": "超小尺寸",
        "height": {
          "$value": "{spacing.6}",
          "$type": "dimension"
        },
        "paddingX": {
          "$value": "{spacing.2}",
          "$type": "dimension"
        },
        "fontSize": {
          "$value": "{fontSize.xs}",
          "$type": "fontSize"
        }
      },
      "sm": {
        "$type": "size",
        "$description": "小尺寸",
        "height": {
          "$value": "{spacing.8}",
          "$type": "dimension"
        },
        "paddingX": {
          "$value": "{spacing.3}",
          "$type": "dimension"
        },
        "fontSize": {
          "$value": "{fontSize.sm}",
          "$type": "fontSize"
        }
      },
      "md": {
        "$type": "size",
        "$description": "中等尺寸",
        "height": {
          "$value": "{spacing.10}",
          "$type": "dimension"
        },
        "paddingX": {
          "$value": "{spacing.4}",
          "$type": "dimension"
        },
        "fontSize": {
          "$value": "{fontSize.base}",
          "$type": "fontSize"
        }
      },
      "lg": {
        "$type": "size",
        "$description": "大尺寸",
        "height": {
          "$value": "{spacing.12}",
          "$type": "dimension"
        },
        "paddingX": {
          "$value": "{spacing.6}",
          "$type": "dimension"
        },
        "fontSize": {
          "$value": "{fontSize.lg}",
          "$type": "fontSize"
        }
      },
      "xl": {
        "$type": "size",
        "$description": "超大尺寸",
        "height": {
          "$value": "{spacing.16}",
          "$type": "dimension"
        },
        "paddingX": {
          "$value": "{spacing.8}",
          "$type": "dimension"
        },
        "fontSize": {
          "$value": "{fontSize.xl}",
          "$type": "fontSize"
        }
      }
    },
    "states": {
      "focus": {
        "$type": "state",
        "$description": "焦点状态",
        "outline": {
          "$value": "{border.focus}",
          "$type": "color"
        },
        "outlineWidth": {
          "$value": "2px",
          "$type": "dimension"
        },
        "outlineOffset": {
          "$value": "2px",
          "$type": "dimension"
        }
      },
      "loading": {
        "$type": "state",
        "$description": "加载状态",
        "opacity": {
          "$value": 0.7,
          "$type": "number"
        },
        "pointerEvents": {
          "$value": "none",
          "$type": "custom"
        }
      }
    }
  }
}