{
  "name": "@th-ui/tokens",
  "version": "0.1.0",
  "description": "TH-UI Design Tokens - Design system tokens and color palettes",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "colors",
    "th-ui"
  ],
  "author": "TH-UI Team",
  "license": "MIT",
  "peerDependencies": {},
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.3.0"
  },
  "sideEffects": false
}
