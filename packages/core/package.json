{
  "name": "@xorigo-ui/core",
  "version": "2025.11.03",
  "description": "Xorigo UI Core - Legacy compatibility layer (will be deprecated)",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.mjs",
      "require": "./dist/primitives.cjs.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.mjs",
      "require": "./dist/forms.cjs.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.mjs",
      "require": "./dist/layout.cjs.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.mjs",
      "require": "./dist/navigation.cjs.js"
    },
    "./overlays": {
      "types": "./dist/overlays.d.ts",
      "import": "./dist/overlays.mjs",
      "require": "./dist/overlays.cjs.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "import": "./dist/feedback.mjs",
      "require": "./dist/feedback.cjs.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.cjs.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.mjs",
      "require": "./dist/theme.cjs.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "build:strict": "tsc && vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "vite --port 3001 --host",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ai": "vitest run ai"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "legacy",
    "xorigo-ui"
  ],
  "author": "Xorigo UI Team",
  "license": "MIT",
  "peerDependencies": {
    "framer-motion": "^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@xorigo-ui/tokens": "file:../tokens",
    "@xorigo-ui/system": "file:../system",
    "@xorigo-ui/utils": "file:../utils",
    "@xorigo-ui/primitives": "file:../primitives",
    "@xorigo-ui/forms": "file:../forms",
    "@xorigo-ui/layout": "file:../layout",
    "@xorigo-ui/navigation": "file:../navigation",
    "@xorigo-ui/overlays": "file:../overlays",
    "@xorigo-ui/feedback": "file:../feedback",
    "@xorigo-ui/i18n": "file:../i18n",
    "@xorigo-ui/style-recipe": "file:../style-recipe",
    "@xorigo-ui/hooks": "file:../hooks"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@vitest/coverage-v8": "^4.0.7",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.0.7"
  },
  "sideEffects": false,
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.52.4"
  }
}