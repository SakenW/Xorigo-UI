  "scripts": {
    "dev": "vite --port 3001 --host",
    "dev:local": "vite --port 3001 --host",
    "dev:check": "node scripts/check-dev-env.js",
    "build": "vite build",
    "build:ssr": "vite build --config vite.config.ssr.ts",
    "build:all": "npm run build && npm run build:ssr",
    "build:strict": "tsc && vite build",
    "build:ssr:strict": "tsc && vite build --config vite.config.ssr.ts",
    "build:types": "tsc --emitDeclarationOnly",
    "preview": "vite preview --port 3002",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "test": "vitest",
    "test:ssr": "vitest --run src/ssr/**/*.test.ts",
    "test:ssr:watch": "vitest src/ssr/**/*.test.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ssr:coverage": "vitest --coverage src/ssr/**/*.test.ts",
    "test:accessibility": "vitest --run src/components/__tests__/*.accessibility.test.tsx",
    "accessibility:check": "tsx scripts/check-accessibility.ts",
    "accessibility:check:components": "tsx scripts/check-accessibility.ts --components Button,Input,Modal,Alert",
    "accessibility:check:report": "tsx scripts/check-accessibility.ts --output accessibility-report.md",
    "color-contrast:check": "tsx scripts/check-accessibility.ts --theme default",
    "compliance:naming": "tsx src/agents/ComplianceCLI.ts naming",
    "compliance:structure": "tsx src/agents/ComplianceCLI.ts structure",
    "compliance:api": "tsx src/agents/ComplianceCLI.ts api",
    "compliance:full": "tsx src/agents/ComplianceCLI.ts full",
    "compliance:fix": "tsx src/agents/ComplianceCLI.ts fix",
    "compliance:report": "tsx src/agents/ComplianceCLI.ts report",
    "compliance:check": "tsx src/agents/ComplianceCLI.ts full --ci",
    "compliance:watch": "tsx src/agents/ComplianceCLI.ts full --watch",
    "clean": "rm -rf dist dist-ssr node_modules"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "tailwind",
    "framer-motion",
    "typescript",
    "ssr",
    "server-side-rendering",
    "nextjs",
    "xorigo-ui"
  ],
