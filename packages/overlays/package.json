{
  "name": "@xorigo-ui/overlays",
  "version": "2025.11.05",
  "description": "Xorigo UI Overlays - Overlay components layer",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.mjs",
      "require": "./dist/dialog.cjs.js"
    },
    "./sheet": {
      "types": "./dist/sheet.d.ts",
      "import": "./dist/sheet.mjs",
      "require": "./dist/sheet.cjs.js"
    },
    "/popover": {
      "types": "./dist/popover.d.ts",
      "import": "./dist/popover.mjs",
      "require": "./dist/popover.cjs.js"
    },
    "./drawer": {
      "types": "./dist/drawer.d.ts",
      "import": "./dist/drawer.mjs",
      "require": "./dist/drawer.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react",
    "ui",
    "overlays",
    "dialog",
    "modal",
    "popover",
    "overlay-components",
    "design-system"
  ],
  "author": "Xorigo UI Team",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "framer-motion": "^12.0.0"
  },
  "dependencies": {
    "@xorigo-ui/primitives": "file:../tokens",
    "@xorigo-ui/tokens": "file:../tokens",
    "@xorigo-ui/system": "file:../tokens",
    "@radix-ui/react-dialog": "^1.1.15",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  },
  "sideEffects": false
}