{
  "name": "@xorigo-ui/registry",
  "version": "0.1.0",
  "description": "Xorigo UI 组件注册表生成器",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "generate": "tsx scripts/generate-registry.ts",
    "validate": "tsx scripts/validate-registry.ts"
  },
  "dependencies": {
    "@xorigo-ui/core": "file:../core",
    "class-variance-authority": "^0.7.1",
    "mlly": "^1.8.0",
    "pkg-types": "^1.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.3.0"
  },
  "keywords": [
    "registry",
    "components",
    "design-system",
    "xorigo-ui"
  ],
  "author": "Xorigo UI Team",
  "license": "MIT",
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.52.4"
  }
}
