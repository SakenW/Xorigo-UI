{
  "name": "@xorigo-ui/layout",
  "version": "2025.11.03",
  "description": "Xorigo UI Layout - Layout components layer",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs.js"
    }
