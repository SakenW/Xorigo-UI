  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react",
    "ui",
    "layout",
    "grid",
    "flex",
    "layout-components",
    "design-system"
  ],
  "author": "Xorigo UI Team",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "framer-motion": "^12.0.0"
  },
  "dependencies": {
    "@xorigo-ui/primitives": "file:../tokens",
    "@xorigo-ui/tokens": "file:../tokens",
    "@xorigo-ui/system": "file:../tokens",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  },
  "sideEffects": false
}