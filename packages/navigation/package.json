{
  "name": "@xorigo-ui/navigation",
  "version": "0.1.0",
  "description": "Xorigo UI Navigation - Navigation components layer",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs.js"
    },
    "./sidebar": {
      "types": "./dist/sidebar.d.ts",
      "import": "./dist/sidebar.mjs",
      "require": "./dist/sidebar.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react",
    "ui",
    "navigation",
    "sidebar",
    "breadcrumb",
    "nav-components",
    "design-system"
  ],
  "author": "Xorigo UI Team",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "framer-motion": "^12.0.0"
  },
  "dependencies": {
    "@xorigo-ui/primitives": "workspace:*",
    "@xorigo-ui/tokens": "workspace:*",
    "@xorigo-ui/system": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  },
  "sideEffects": false
}