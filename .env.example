# ============================================
# Xorigo UI 开发环境配置
# ============================================

# 端口配置
# 注意：避免使用 3000 端口，为其他库让路
CORE_DEV_PORT=3001
CORE_PREVIEW_PORT=3002
WEBSITE_PORT=3100
RECIPES_PORT=3101
STORYBOOK_PORT=6006
REDIS_PORT=6380

# 开发模式设置
NODE_ENV=development

# 核心库配置
VITE_PORT=3001
VITE_HOST=0.0.0.0
VITE_SERVER_PORT=3001

# Website 配置
NEXT_PUBLIC_CORE_URL=http://localhost:3001
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:3100/api

# 调试配置
DEBUG=vite:*
NEXT_TELEMETRY_DISABLED=1

# 缓存配置
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
FAST_REFRESH=true

# 主题配置
NEXT_PUBLIC_DEFAULT_THEME=midnight
NEXT_PUBLIC_THEME_PRESETS=ocean,forest,sunset,lavender

# API 配置
NEXT_PUBLIC_API_BASE_URL=http://localhost:3100/api
NEXT_PUBLIC_STORYBOOK_URL=http://localhost:6006

# Docker 配置
COMPOSE_PROJECT_NAME=xorigo-ui-dev
COMPOSE_FILE=docker-compose.dev.yml

# Redis 配置（可选）
REDIS_PASSWORD=dev123
REDIS_HOST=localhost
REDIS_PORT=6380

# 开发工具配置
ENABLE_SOURCE_MAPS=true
ENABLE_ANALYTICS=false
ENABLE_ERROR_OVERLAY=true

# 性能配置
NEXT_BUNDLE_ANALYZER=false
NEXT_OPTIMIZE_FONTS=false