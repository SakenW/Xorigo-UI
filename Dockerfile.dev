# ============================================
# Xorigo UI Monorepo 开发环境 Dockerfile
# Node.js 22 Alpine + Hot Reload Support
# ============================================
FROM node:22-alpine

# 设置工作目录
WORKDIR /app

# 安装依赖所需的系统工具
RUN apk add --no-cache git

# 复制依赖文件（Monorepo 结构）
COPY package.json package-lock.json* ./
COPY packages/core/package.json ./packages/core/
COPY apps/website/package.json ./apps/website/

# 安装依赖（使用 --legacy-peer-deps 解决依赖冲突）
RUN npm install --legacy-peer-deps

# 复制源代码
COPY . .

# 暴露端口（Vite 和 Next.js）
EXPOSE 5173 3100

# 默认启动命令（可在 docker-compose 中覆盖）
CMD ["npm", "run", "dev", "-w", "@xorigo-ui/core"]
