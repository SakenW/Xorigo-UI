# 开发环境 Dockerfile (支持热更新)
FROM node:22-alpine

WORKDIR /app

# 复制依赖文件
COPY package.json package-lock.json* pnpm-lock.yaml* yarn.lock* ./

# 安装依赖
RUN if [ -f pnpm-lock.yaml ]; then \
      corepack enable && \
      pnpm install; \
    elif [ -f yarn.lock ]; then \
      yarn install; \
    else \
      npm install; \
    fi

# 复制源代码
COPY . .

# 暴露 Vite 开发服务器端口
EXPOSE 5173

# 启动开发服务器
CMD ["npm", "run", "dev"]
