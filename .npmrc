# NPM配置文件
# 用于控制包发布行为

# 基础配置
registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}

# 发布配置
access=public
tag=latest

# 安全配置
audit-level=high
fund=false
optional=false

# 缓存配置
cache=/tmp/npm-cache

# 工作区配置
workspaces=true
legacy-peer-deps=false

# 构建配置
scripts-prepend-node-path=true

# 开发环境配置
# 使用环境变量覆盖：
# NPM_CONFIG_REGISTRY=https://npm.pkg.github.com/ (GitHub Packages)
# NPM_CONFIG_REGISTRY=https://registry.npm.pkg.github.com/ (GitHub Packages)
# NPM_CONFIG_TAG=beta (beta发布)
# NPM_CONFIG_TAG=alpha (alpha发布)