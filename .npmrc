# .npmrc
# TH-UI Monorepo - npm/pnpm/yarn/bun configuration

# Auto install peers (for pnpm)
auto-install-peers=true

# Strict peer dependencies (can be set to false for compatibility)
strict-peer-dependencies=false

# Use workspace protocol for local packages (pnpm)
# This allows using workspace:* which will be resolved correctly
link-workspace-packages=true

# Hoist pattern (helps with compatibility across package managers)
shamefully-hoist=false

# Node linker (optional, for compatibility)
# node-linker=hoisted

# Engine strict (ensure Node.js version requirements)
engine-strict=true

# Save exact versions (optional)
# save-exact=true

# Public hoist pattern (for better compatibility)
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*typescript*
