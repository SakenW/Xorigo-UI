/**
 * 客户端组件调试测试
 */

'use client'

import { useEffect, useState } from 'react'

export default function TestClientDebugPage() {
  const [mounted, setMounted] = useState(false)
  const [count, setCount] = useState(0)

  useEffect(() => {
    console.log('🔍 Client component mounting...')
    setMounted(true)

    // 测试浏览器 API
    console.log('🔍 Window object:', typeof window !== 'undefined')
    console.log('🔍 URL params:', window.location.search)

    return () => {
      console.log('🔍 Client component unmounting...')
    }
  }, [])

  const handleClick = () => {
    console.log('🔍 Button clicked')
    setCount(count + 1)
  }

  if (!mounted) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gray-100">
        <div className="text-center">
          <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto mb-4"></div>
          <p className="text-gray-600">客户端组件加载中...</p>
        </div>
      </div>
    )
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-8">
      <div className="max-w-4xl mx-auto">
        <div className="bg-white rounded-xl shadow-lg p-8">
          <h1 className="text-3xl font-bold text-gray-900 mb-6">
            🔍 客户端组件调试测试
          </h1>

          <div className="space-y-6">
            {/* 状态指示器 */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="p-4 bg-green-50 border border-green-200 rounded-lg">
                <h3 className="text-sm font-medium text-green-800 mb-2">组件状态</h3>
                <p className="text-green-700">✅ 已挂载</p>
                <p className="text-green-700">✅ useState 工作正常</p>
                <p className="text-green-700">✅ useEffect 工作正常</p>
              </div>

              <div className="p-4 bg-blue-50 border border-blue-200 rounded-lg">
                <h3 className="text-sm font-medium text-blue-800 mb-2">交互测试</h3>
                <button
                  onClick={handleClick}
                  className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                >
                  点击测试 (计数: {count})
                </button>
                <p className="text-blue-700 mt-2 text-sm">点击按钮查看控制台日志</p>
              </div>
            </div>

            {/* 环境信息 */}
            <div className="p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
              <h3 className="text-sm font-medium text-yellow-800 mb-2">环境信息</h3>
              <div className="space-y-1 text-sm text-yellow-700">
                <p><strong>客户端:</strong> {typeof window !== 'undefined' ? '是' : '否'}</p>
                <p><strong>URL:</strong> {typeof window !== 'undefined' ? window.location.href : 'N/A'}</p>
                <p><strong>参数:</strong> {typeof window !== 'undefined' ? window.location.search : 'N/A'}</p>
              </div>
            </div>

            {/* 成功消息 */}
            <div className="p-4 bg-green-50 border border-green-200 rounded-lg text-center">
              <h3 className="text-lg font-medium text-green-800 mb-2">
                🎉 客户端组件正常工作！
              </h3>
              <p className="text-green-700">
                如果您能看到这个页面，说明客户端组件渲染没有问题。
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}