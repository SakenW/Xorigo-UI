# Website 环境变量示例
# 复制此文件为 .env.local 并填入实际的值

# ======================
# 错误监控配置 (Sentry)
# ======================
# 从 https://sentry.io 获取 DSN
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# 应用版本 (自动从 package.json 读取)
# NEXT_PUBLIC_APP_VERSION=1.0.0

# ======================
# 会话录制配置 (LogRocket)
# ======================
# 从 https://app.logrocket.com 获取 App ID
NEXT_PUBLIC_LOGROCKET_APP_ID=your-app-id/your-app-name

# ======================
# 错误监控开关
# ======================
# 是否启用 Sentry (生产环境建议开启)
NEXT_PUBLIC_ENABLE_SENTRY=false
# 是否启用 LogRocket (生产环境建议开启)
NEXT_PUBLIC_ENABLE_LOGROCKET=false

# ======================
# 其他配置
# ======================
# API 基础路径
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
