{
  "name": "website",
  "version": "0.1.0",
  "description": "Xorigo UI 官方网站 - 基于 Next.js 16 App Router",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100 --hostname 0.0.0.0",
    "dev:local": "next dev --port 3100 --hostname 0.0.0.0",
    "dev:bypass": "next dev --port 3100 --hostname 0.0.0.0",
    "dev:check": "node scripts/check-dev-env.js",
    "prebuild": "echo 'Skipping prebuild for development'",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsx scripts/type-check.ts",
    "type-check:strict": "tsc --noEmit --strict",
    "format": "prettier --write \"app/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:data": "vitest run src/data/__tests__",
    "check:data": "tsx scripts/check-data-integrity.ts",
    "validate:data": "tsx scripts/validate-readonly-consistency.ts",
    "validate:all": "tsx scripts/validate-readonly-consistency.ts && tsx scripts/type-check.ts && npm run lint",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "build:search-index": "tsx scripts/build-search-index.ts",
    "test:search-performance": "tsx scripts/test-search-performance.ts"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.15",
    "@tanstack/react-query": "^5.90.2",
    "@tiptap/react": "^3.6.6",
    "@xorigo-ui/tokens": "file:../../packages/tokens",
    "@xorigo-ui/system": "file:../../packages/system",
    "@xorigo-ui/utils": "file:../../packages/utils",
    "@xorigo-ui/core": "file:../../packages/core",
    "@xorigo-ui/style-recipe": "file:../../packages/style-recipe",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "color-contrast-checker": "^2.1.0",
    "culori": "^4.0.2",
    "esbuild": "^0.25.10",
    "framer-motion": "^12.23.5",
    "fuse.js": "^7.1.0",
    "jsdom": "^27.0.0",
    "lucide-react": "^0.545.0",
    "next": "^16.0.1",
    "next-themes": "^0.4.6",
    "process": "^0.11.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "zod": "^4.1.12",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "puppeteer": "^24.24.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "next.js",
    "react",
    "ui-components",
    "design-system",
    "xorigo-ui",
    "website"
  ],
  "author": "Xorigo UI Team",
  "license": "MIT",
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.52.4"
  }
}
