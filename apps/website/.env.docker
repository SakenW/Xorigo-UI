# ============================================
# Xorigo UI Website Docker 开发环境配置
# ============================================

# 基础配置
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# 端口配置
PORT=3100
HOSTNAME=0.0.0.0

# 热更新配置
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
FAST_REFRESH=true

# 调试配置
NEXT_PUBLIC_DEBUG=true
NEXT_PUBLIC_DEV_MODE=true

# 主题配置
NEXT_PUBLIC_DEFAULT_THEME=system
NEXT_PUBLIC_DEFAULT_DENSITY=modern

# 数据源配置
NEXT_PUBLIC_REGISTRY_URL=http://localhost:3100/api/registry
NEXT_PUBLIC_TOKENS_URL=http://localhost:3100/api/tokens
NEXT_PUBLIC_DOCS_URL=http://localhost:3100/api/docs

# 性能监控
NEXT_PUBLIC_MONITORING_ENABLED=true
NEXT_PUBLIC_PERFORMANCE_TRACKING=true

# 功能开关
NEXT_PUBLIC_PLAYGROUND_ENABLED=true
NEXT_PUBLIC_TOKEN_INSPECTOR_ENABLED=true
NEXT_PUBLIC_SNAPSHOT_MANAGER_ENABLED=true
NEXT_PUBLIC_COMPARE_MODE_ENABLED=true

# 开发工具
NEXT_PUBLIC_CLI_ENABLED=true
NEXT_PUBLIC_DOCTOR_ENABLED=true
NEXT_PUBLIC_SYNC_ENABLED=true

# 错误边界
NEXT_PUBLIC_ERROR_BOUNDARY_DEBUG=true
NEXT_PUBLIC_ERROR_REPORTING=true

# 缓存配置
NEXT_PUBLIC_CACHE_MAX_AGE=300
NEXT_PUBLIC_REVALIDATE_TIME=30

# 构建配置
ANALYZE_BUNDLE=false
LINT_KILLED=false

# 安全配置
NEXT_PUBLIC_SECURITY_HEADERS=true
NEXT_PUBLIC_CSP_ENABLED=true

# 国际化
NEXT_PUBLIC_DEFAULT_LOCALE=zh-CN
NEXT_PUBLIC_LOCALES=zh-CN,en-US

# API 配置
API_URL=http://localhost:3100/api
API_TIMEOUT=10000

# 监控模式（可选）
MONITOR_MODE=false
MONITOR_PORT=3101

# Redis 配置（如果使用）
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=dev123

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=dev

# 开发优化
DEV_SERVER_RESTART_ON_ERROR=true
DEV_SERVER_RESTART_TIMEOUT=30

# 内存和性能优化
NEXT_MAX_MEMORY_ALLOCATION=4096
NEXT_MINIMIZE_THREADS=false

# 开发工具集成
NEXT_PUBLIC_DEVTOOLS_INTEGRATION=true
NEXT_PUBLIC_HOT_RELOAD=true

# Storybook 配置
STORYBOOK_PORT=6009
STORYBOOK_HOST=localhost