# ============================================
# Xorigo UI Website 开发环境 Dockerfile
# Next.js 15 + Node.js 22 Alpine + Monorepo 支持
# ============================================
FROM node:22-alpine AS development

# 设置工作目录
WORKDIR /app

# 安装必要的系统工具
RUN apk add --no-cache git curl wget bash

# 设置 npm 配置（新版本npm已不需要unsafe-perm）
# RUN npm config set unsafe-perm true

# 复制Website应用依赖文件（构建上下文在apps/website）
COPY package.json package-lock.json* ./

# 安装Website依赖
RUN npm install --legacy-peer-deps --no-audit --no-fund

# 复制Website应用源代码
COPY . ./

# 创建必要的目录
RUN mkdir -p .next node_modules/.cache

# 设置权限
RUN chown -R node:node /app

# 切换到 node 用户（安全考虑）
USER node

# 暴露 Next.js 开发服务器端口
EXPOSE 3100

# 健康检查端点
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3100/api/health || exit 1

# 开发环境启动命令
CMD ["./docker-entrypoint.dev.sh"]