{
  "extends": "astro/tsconfigs/strict",
  "include": [
    "**/*",
    "../.astro/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@xorigo-ui/core": ["../../packages/core/src"],
      "@xorigo-ui/tokens": ["../../packages/tokens/src"]
    }
  },
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/tokens"
    }
  ]
}