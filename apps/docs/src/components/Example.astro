---
interface Props {
  code: string;
  client?: boolean;
}

const { code, client = false } = Astro.props;

// 在服务端渲染代码显示
const highlightedCode = await Astro.slots.render(code);
---

<div class="example-container">
  <div class="example-preview" {client ? 'client:load' : ''}>
    <slot />
  </div>
  <details class="example-code">
    <summary>查看代码</summary>
    <pre class="astro-code monokai">
      <code>{highlightedCode}</code>
    </pre>
  </details>
</div>

<style>
  .example-container {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
    margin: 1.5rem 0;
  }

  .example-preview {
    padding: 1.5rem;
    background: var(--sl-color-gray-2);
  }

  .example-code {
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .example-code summary {
    padding: 0.75rem 1.5rem;
    background: var(--sl-color-gray-1);
    cursor: pointer;
    font-weight: 500;
    border: none;
    width: 100%;
    text-align: left;
  }

  .example-code summary:hover {
    background: var(--sl-color-gray-2);
  }

  .example-code pre {
    margin: 0;
    padding: 1rem 1.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    overflow-x: auto;
  }

  .example-code code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }
</style>