{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Xorigo UI",
  "entryPoints": [
    "packages/core/src/index.ts",
    "packages/system/src/index.ts",
    "packages/hooks/src/index.ts",
    "packages/tokens/src/index.ts",
    "packages/style-recipe/src/index.ts"
  ],
  "out": "docs/api",
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "readme": "README.md",
  "tsconfig": "tsconfig.base.json",
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/node_modules/**",
    "**/dist/**"
  ],
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeExternals": true,
  "includeVersion": true,
  "navigationLinks": {
    "GitHub": "https://github.com/your-org/xorigo-ui",
    "Website": "http://localhost:3000"
  },
  "categorizeByGroup": true,
  "categoryOrder": [
    "Components",
    "Hooks",
    "Types",
    "Utilities",
    "*"
  ],
  "sort": [
    "source-order"
  ],
  "kindSortOrder": [
    "Project",
    "Module",
    "Namespace",
    "Enum",
    "EnumMember",
    "Class",
    "Interface",
    "TypeAlias",
    "Constructor",
    "Property",
    "Variable",
    "Function",
    "Accessor",
    "Method",
    "Parameter",
    "TypeParameter",
    "TypeLiteral",
    "CallSignature",
    "ConstructorSignature",
    "IndexSignature",
    "GetSignature",
    "SetSignature"
  ],
  "searchInComments": true,
  "cleanOutputDir": true,
  "githubPages": false,
  "hideGenerator": false,
  "customCss": "./docs/api-theme.css"
}
