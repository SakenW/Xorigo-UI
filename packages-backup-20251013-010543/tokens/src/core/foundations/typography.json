{
  "$type": "typography",
  "$description": "排版标尺 - 基于 Tailwind CSS 标准",
  "fontFamily": {
    "$type": "fontFamily",
    "$description": "字体族",
    "sans": {
      "$value": ["Inter", "system-ui", "sans-serif"],
      "$type": "fontFamily"
    },
    "mono": {
      "$value": ["JetBrains Mono", "Consolas", "monospace"],
      "$type": "fontFamily"
    }
  },
  "fontSize": {
    "$type": "dimension",
    "$description": "字体大小",
    "xs": {
      "$value": "0.75rem",
      "$type": "dimension",
      "$description": "12px"
    },
    "sm": {
      "$value": "0.875rem",
      "$type": "dimension",
      "$description": "14px"
    },
    "base": {
      "$value": "1rem",
      "$type": "dimension",
      "$description": "16px"
    },
    "lg": {
      "$value": "1.125rem",
      "$type": "dimension",
      "$description": "18px"
    },
    "xl": {
      "$value": "1.25rem",
      "$type": "dimension",
      "$description": "20px"
    },
    "2xl": {
      "$value": "1.5rem",
      "$type": "dimension",
      "$description": "24px"
    },
    "3xl": {
      "$value": "1.875rem",
      "$type": "dimension",
      "$description": "30px"
    },
    "4xl": {
      "$value": "2.25rem",
      "$type": "dimension",
      "$description": "36px"
    },
    "5xl": {
      "$value": "3rem",
      "$type": "dimension",
      "$description": "48px"
    },
    "6xl": {
      "$value": "3.75rem",
      "$type": "dimension",
      "$description": "60px"
    },
    "7xl": {
      "$value": "4.5rem",
      "$type": "dimension",
      "$description": "72px"
    },
    "8xl": {
      "$value": "6rem",
      "$type": "dimension",
      "$description": "96px"
    },
    "9xl": {
      "$value": "8rem",
      "$type": "dimension",
      "$description": "128px"
    }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "$description": "字体粗细",
    "thin": {
      "$value": 100,
      "$type": "fontWeight"
    },
    "extralight": {
      "$value": 200,
      "$type": "fontWeight"
    },
    "light": {
      "$value": 300,
      "$type": "fontWeight"
    },
    "normal": {
      "$value": 400,
      "$type": "fontWeight"
    },
    "medium": {
      "$value": 500,
      "$type": "fontWeight"
    },
    "semibold": {
      "$value": 600,
      "$type": "fontWeight"
    },
    "bold": {
      "$value": 700,
      "$type": "fontWeight"
    },
    "extrabold": {
      "$value": 800,
      "$type": "fontWeight"
    },
    "black": {
      "$value": 900,
      "$type": "fontWeight"
    }
  },
  "lineHeight": {
    "$type": "lineHeight",
    "$description": "行高",
    "none": {
      "$value": 1,
      "$type": "lineHeight"
    },
    "tight": {
      "$value": 1.25,
      "$type": "lineHeight"
    },
    "snug": {
      "$value": 1.375,
      "$type": "lineHeight"
    },
    "normal": {
      "$value": 1.5,
      "$type": "lineHeight"
    },
    "relaxed": {
      "$value": 1.625,
      "$type": "lineHeight"
    },
    "loose": {
      "$value": 2,
      "$type": "lineHeight"
    }
  },
  "letterSpacing": {
    "$type": "letterSpacing",
    "$description": "字母间距",
    "tighter": {
      "$value": "-0.05em",
      "$type": "letterSpacing"
    },
    "tight": {
      "$value": "-0.025em",
      "$type": "letterSpacing"
    },
    "normal": {
      "$value": "0em",
      "$type": "letterSpacing"
    },
    "wide": {
      "$value": "0.025em",
      "$type": "letterSpacing"
    },
    "wider": {
      "$value": "0.05em",
      "$type": "letterSpacing"
    },
    "widest": {
      "$value": "0.1em",
      "$type": "letterSpacing"
    }
  }
}